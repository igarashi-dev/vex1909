            rightLift.set_brake_mode(pros::E_MOTOR_BRAKE_HOLD);
            leftLift.set_brake_mode(pros::E_MOTOR_BRAKE_HOLD);
            liftMotors.set_brake_mode(pros::E_MOTOR_BRAKE_HOLD);
            leftLift.brake();
            rightLift.brake();
            liftMotors.brake();
        }
    
