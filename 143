    int DEADBAND = 5;
void opcontrol() {

//pros::Task clawHandle(clawControl);
        


autonRunning=false;
         pros::Task toggleTask(autoToggleTask);

       
       pros::Task lowerTaskHandle(lowerTask);
       

       
    while (true) {
         int leftX = controller.get_analog(pros::E_CONTROLLER_ANALOG_LEFT_X);
     
