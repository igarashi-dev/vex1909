int liftTarget = 0;
int liftMaxSpeed = 127;
bool liftRunning = false;



void liftTaskFn() {
    liftRunning = true;
    int stable = 0;
    while (true) {
        double pos = rightLift.get_position();
        double err = liftTarget - pos;
        double out = liftPID.update(err);
        if (out > liftMaxSpeed) out = liftMaxSpeed;
        if (out < -liftMaxSpeed) out = -liftMaxSpeed;
        liftMotors.move(out);
        if(fabs(err)<30||cascadeOverride==true){
            stable += 10;
            if(stable >= 150||cascadeOverride==true){
            liftMotors.brake();
            liftRunning=false;
            pinPrime=false;
            return;
            }
        }else{
            stable=0;
}
        pros::delay(10);
    }
    liftMotors.set_brake_mode(pros::MotorBrake::hold);
    liftMotors.brake();
    liftRunning = false;
}


void moveLiftTo(int pos, int maxSpeed) {
    liftTarget = pos;
    liftMaxSpeed = maxSpeed;

    if (liftRunning && liftTask != nullptr) {
        liftTask->remove();      
        delete liftTask;         
        liftTask = nullptr;
        liftRunning = false;
    }
    liftTask = new pros::Task(liftTaskFn);
}




