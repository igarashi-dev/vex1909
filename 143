        //chassis.arcade(rightY, leftX,false);*/
        int leftMotorSpeed= controller.get_analog(pros::E_CONTROLLER_ANALOG_RIGHT_Y)+controller.get_analog(pros::E_CONTROLLER_ANALOG_LEFT_X);
        int rightMotorSpeed= controller.get_analog(pros::E_CONTROLLER_ANALOG_RIGHT_Y)- controller.get_analog(pros::E_CONTROLLER_ANALOG_LEFT_X);
        if(rightY>120||rightY<-120){

        }
        //match driver
        if(rightY<10&&rightY>-10){
            if(leftX<90&&leftX>-90){
                leftMotorSpeed=leftMotorSpeed*0.5;
                rightMotorSpeed= rightMotorSpeed*0.5;
            }
        }
        

        if(abs(leftMotorSpeed) <DEADBAND){
            leftMotors.move(0);
            
        }else{
            leftMotors.move(leftMotorSpeed);
            

        }

        if(abs(rightMotorSpeed)<DEADBAND){
            rightMotors.move(0);
        }else{
            rightMotors.move(rightMotorSpeed);
            
        }

        
        if(controller.get_digital_new_press(pros::E_CONTROLLER_DIGITAL_DOWN)){
            pinPickval=!pinPickval;
            pinPick.set_value(pinPickval);
            if(pinPickval==true){
                pinRaise=true;
            }

        }

        if(controller.get_digital_new_press(pros::E_CONTROLLER_DIGITAL_Y)){
            wedgeValue=!wedgeValue;
            wedge.set_value(wedgeValue);

        }

        
        if(controller.get_digital(pros::E_CONTROLLER_DIGITAL_L1)){
            cascadeOverride=true;
            if(rightLift.get_position()>2700){
            liftMotors.move(0);
            }else if(rightLift.get_position()<2700){
                liftMotors.move(127);
            }else{
                liftMotors.move(0);
            }
        }else if(controller.get_digital(pros::E_CONTROLLER_DIGITAL_L2)&&pinPickval==true){
