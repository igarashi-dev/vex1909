pros::Optical toggleOptical(1);

bool toggleLocked=false;

enum ToggleColor {
RED,
YELLOW,
BLUE,
UNKNOWN
};
ToggleColor targetColor = RED;

volatile bool autoToggle = false;
ToggleColor getToggleColor() {
    double hue = toggleOptical.get_hue();
    if (hue >= 0 && hue <= 45) {
        return RED; 
    }if (hue >= 47 && hue <= 60) {
        return YELLOW;
    }if (hue >= 65 && hue <= 155) {
        return BLUE;
    }
    return UNKNOWN;
}

void autoToggleTask() {
    toggleOptical.set_led_pwm(100);
    while (true) {
        if(controller.get_digital(pros::E_CONTROLLER_DIGITAL_LEFT)){
            toggleMotor.move(-127);
        }else if (controller.get_digital(pros::E_CONTROLLER_DIGITAL_R2) && !toggleLocked) {
            int correctColorCount = 0;
            toggleMotor.move(127);
        while (controller.get_digital(pros::E_CONTROLLER_DIGITAL_R2)&& !toggleLocked) {
            ToggleColor currentColor = getToggleColor();
            if (currentColor == targetColor) {
                correctColorCount++;
                if (correctColorCount >= 1) {
                    toggleMotor.move(0);
                    toggleMotor.brake();
                    break;
                }
            } else {
                correctColorCount = 0;
            }   
            pros::delay(20);
        }
        toggleMotor.move(0);
        toggleMotor.brake();
        }else if(controller.get_digital(pros::E_CONTROLLER_DIGITAL_R2)&&toggleLocked){
            toggleMotor.move(127);
        }else{
            toggleMotor.move(0);
        }
        pros::delay(10);
    }
}





