void autoClampTask(void*){
    while(true){
        if(autoClamp==true){
            if(leftAutoClampDistance.get_distance()<Ldistance|| RightAutoClampDistance.get_distance()<Rdistance){
                clamp.set_value(false);
                if(autoClampRaise==true){
                pros::delay(200);
                chainBarMotor.move(25);
                pros::delay(200);
                chainBarMotor.move(0);
                autoClampRaise=false;
                }
            }

        }
        pros::delay(10);
    }
}
