void liftTaskFn() {
    liftRunning = true;
    int stable = 0;

    while (true) {
        double pos = leftLift.get_position();
        double err = liftTarget - pos;
        double out = liftPID.update(err);
        if (out > liftMaxSpeed) out = liftMaxSpeed;
        if (out < -liftMaxSpeed) out = -liftMaxSpeed;
        //liftMotors.set_brake_mode(pros::E_MOTOR_BRAKE_COAST);
        liftMotors.move(out);


        if(fabs(err)<30||cascadeOverride==true){
    stable += 10;

    if(stable >= 150||cascadeOverride==true){

        liftMotors.brake();
        liftRunning=false;
        pinPrime=false;

        return;
    }

}else{
    stable=0;
}

        pros::delay(10);
    }

    liftMotors.set_brake_mode(pros::MotorBrake::hold);
    liftMotors.brake();
    liftRunning = false;
}


void moveLiftTo(int pos, int maxSpeed) {
    liftTarget = pos;
    liftMaxSpeed = maxSpeed;

    if (liftRunning && liftTask != nullptr) {
        liftTask->remove();      // stop the task
        delete liftTask;         // free memory
        liftTask = nullptr;
        liftRunning = false;
    }

    liftTask = new pros::Task(liftTaskFn);
}

void chainTaskFn() {
    chainRunning = true;
    int stable = 0;
    while (true) {
       
        double pos = chainBarMotor.get_position();
        double err = chainTarget - pos;
        double out = chainPID.update(err);
        if (out > chainMaxSpeed) out= chainMaxSpeed;
        if (out < -chainMaxSpeed) out = -chainMaxSpeed;
        chainBarMotor.move(out);
       if (fabs(err) < 30||driverOverride==true) {
            stable += 10;
            if (stable >= 150||driverOverride==true){
                chainBarMotor.brake();
                chainRunning=false;
                if (liftAfterChain) {
        liftAfterChain = false;
            moveLiftTo(0, 127);

            liftlowering = false;
    }
                return;
            }
        } else {
            stable = 0;
        }
    
        pros::delay(10);
    
    
    }
    chainBarMotor.set_brake_mode(pros::MotorBrake::hold);
    chainBarMotor.brake();
    chainRunning = false;
}

