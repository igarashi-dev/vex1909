pros::Motor rightChain(-3);

//Initialize Match loader piston
pros::adi::DigitalOut tMeck('B');

//Initialize clamp piston
pros::adi::DigitalOut clamp('G');

pros::adi::DigitalOut Rake('H');

//Initialize inertial sensor 
pros::Imu imu(16);

//Initialize distance sensor for back goal detection
pros::Distance goalSensor(13);

//Initialize distance sensor for object detection
pros::Distance objectSensor(20);

//Initialize distance sensor for clamp detection
pros::Distance autoClamp(1);

//Initialize distance sensor for front goal detection
