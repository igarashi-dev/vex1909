//Initialize controller
pros::Controller controller(pros::E_CONTROLLER_MASTER);

//Initialize the left side of the drivetrain motors and their ports
pros::MotorGroup leftMotors({-14, -4, -11}); 

//Initialize the right side of the drivetrain motors and their ports
pros::MotorGroup rightMotors({19,17,7}); 

pros::MotorGroup fullDrive({-14, -11, -4, 19, 17, 7}, pros::MotorGearset::blue);

//Initialize intake motors into a motor group
pros::MotorGroup liftMotors({-12,18}, pros::MotorGearset::blue);

pros::Motor leftLift(18);

pros::Motor rightLift(-12);

